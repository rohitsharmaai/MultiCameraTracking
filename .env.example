# Copy to .env and fill in.

# postgresql+psycopg2://user:pass@localhost:5432/mct
# sqlite:///./data/gallery.db   (dev/test persistence only; not production)
DATABASE_URL=postgresql+psycopg2://mct:mct@localhost:5432/mct

# production requires PostgreSQL + pgvector and refuses SQLite
ENVIRONMENT=development

# API authentication (required for every endpoint except GET /health)
API_KEY=change-me

# Optional CPU fallback when CUDA is unavailable
ALLOW_CPU_FALLBACK=true

# Model directory
MODELS_DIR=models

# Optional: where the operator GUI stores person crop images. Defaults to
# ./data/gui_snapshots. Point this outside the working tree if it gets cleaned.
# SNAPSHOT_DIR=~/.multicam_reid/gui_snapshots
